# API
PORT=8787
ISSUER_WEBHOOK_SECRET=whsec_sandbox_secret
DASHBOARD_URL=http://localhost:3000

# Set to "true" only on a deployment that actually terminates TLS in front of
# it (the AWS stack sets this automatically when a domain is configured).
# When true, every /v1/* request arriving with X-Forwarded-Proto: http is
# refused. Leave unset for local dev — this is not what makes the session
# cookie Secure (that's NODE_ENV=production); it's an independent,
# server-side check that also covers a leaked Bearer API key.
ACARD_REQUIRE_HTTPS=

# Postgres persistence (omit DATABASE_URL to run in-memory only, sandbox-style)
DATABASE_URL=postgres://acard:acard@localhost:5432/acard

# AES-256-GCM key for card data at rest in Postgres (64 hex chars = 32 bytes).
# Generate with: openssl rand -hex 32
# Omit and the API generates a random per-process key with a loud warning —
# fine for local dev, NOT fine for production (data becomes undecryptable on
# every restart). Set a real key and keep it before storing real card data.
ACARD_ENCRYPTION_KEY=

# PayFast — real wallet funding AND subscription billing, same processor and
# webhook (omit all three to keep instant sandbox top-ups / free-tier-only)
# NOTE: PayFast's checkout has no currency field — the USD-priced tiers in
# packages/core/src/billing.ts only bill correctly if PayFast has confirmed
# this merchant account bills in USD. See apps/api/src/payfast.ts's header.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# WorkOS SSO — additive to password + TOTP MFA login (omit both to run without it)
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# Slack incoming webhook for approval-request notifications (optional)
SLACK_APPROVALS_WEBHOOK_URL=

# MCP server / CLI
ACARD_API_URL=http://localhost:8787
ACARD_API_KEY=
MCP_HTTP_PORT=8788

# Dashboard
NEXT_PUBLIC_ACARD_API_URL=http://localhost:8787
