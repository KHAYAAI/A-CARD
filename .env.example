# API
PORT=8787
ISSUER_WEBHOOK_SECRET=whsec_sandbox_secret
DASHBOARD_URL=http://localhost:3000

# Postgres persistence (omit DATABASE_URL to run in-memory only, sandbox-style)
DATABASE_URL=postgres://acard:acard@localhost:5432/acard

# PayFast — real wallet funding AND subscription billing, same processor and
# webhook (omit all three to keep instant sandbox top-ups / free-tier-only)
# NOTE: PayFast's checkout has no currency field — the USD-priced tiers in
# packages/core/src/billing.ts only bill correctly if PayFast has confirmed
# this merchant account bills in USD. See apps/api/src/payfast.ts's header.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# WorkOS SSO — additive to password + TOTP MFA login (omit both to run without it)
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# Slack incoming webhook for approval-request notifications (optional)
SLACK_APPROVALS_WEBHOOK_URL=

# MCP server / CLI
ACARD_API_URL=http://localhost:8787
ACARD_API_KEY=
MCP_HTTP_PORT=8788

# Dashboard
NEXT_PUBLIC_ACARD_API_URL=http://localhost:8787
