{
  "name": "acard",
  "private": true,
  "version": "0.1.0",
  "description": "A-CARD — virtual cards for AI agents (Agentcard-style platform, South Africa first)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p apps/api && tsc -p apps/mcp && tsc -p apps/cli && tsc -p packages/sdk && tsc -p examples",
    "dev:api": "npm run dev -w @acard/api",
    "dev:mcp": "npm run dev -w @acard/mcp",
    "dev:dashboard": "npm run dev -w @acard/dashboard",
    "openapi": "tsx apps/api/scripts/write-openapi.ts",
    "recording-kit": "tsx marketing/recording-kit/kit.ts",
    "recording-kit:check": "tsx marketing/recording-kit/rehearse.ts",
    "plugins:build": "node apps/mcp/scripts/bundle.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
