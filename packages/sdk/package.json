{
  "name": "@acard/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the A-CARD API: scoped cards for AI agents, A-MERCHANT supply search, and webhook verification.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./webhooks": "./src/webhooks.ts"
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "./webhooks": { "types": "./dist/webhooks.d.ts", "default": "./dist/webhooks.js" }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "engines": { "node": ">=20" },
  "license": "UNLICENSED"
}
